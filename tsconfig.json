{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "ignoreDeprecations": "5.0",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  }
}
